<mxfile host="app.diagrams.net"><diagram id="bpmn1" name="As-Is"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="guest" value="Гість (зовнішній учасник, «чорна скринька»)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="40" as="geometry"/></mxCell><mxCell id="pool" value="Бізнес-центр: оформлення гостьового пропуску (As-Is)" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1500" height="370" as="geometry"/></mxCell><mxCell id="laneA" value="Співробітник-орендар" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#ffffff;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="1470" height="170" as="geometry"/></mxCell><mxCell id="laneB" value="Охоронець (пост охорони)" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#ffffff;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="1470" height="200" as="geometry"/></mxCell><mxCell id="S1" value="Потрібно&lt;br&gt;прийняти гостя" style="html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;shape=mxgraph.bpmn.shape;fontSize=10;outline=standard;symbol=general;" vertex="1" parent="1"><mxGeometry x="140" y="187" width="36" height="36" as="geometry"/></mxCell><mxCell id="T1" value="Зателефонувати на пост охорони: назвати ПІБ гостя, час і мету візиту" style="shape=mxgraph.bpmn.task;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;taskMarker=user;fillColor=#fff2cc;strokeColor=#333333;fontSize=1